# Copy to keystore.properties (git-ignored) and fill in. Create the key once with:
#   keytool -genkeypair -v -keystore coiltag-upload.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
# Back up the .jks file and passwords somewhere safe: without them you cannot publish updates.
storeFile=coiltag-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
